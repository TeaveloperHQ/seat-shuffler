<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SeatShuffler.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600"
             x:Class="SeatShuffler.Views.DecorateView"
             x:DataType="vm:DecorateViewModel">

    <Design.DataContext>
        <vm:DecorateViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- 스킨 + 옵션 + 출력 -->
        <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">

                <!-- 불러오기 -->
                <TextBlock Text="불러오기" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4,8,4"/>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          Width="240" VerticalAlignment="Center" Margin="0,4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:ChartSource"><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,4" VerticalAlignment="Center"/>

                <!-- 스킨 (라벨 생략) — 작은 색칩 -->
                <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                         Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                         Margin="0,4">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ChartSkin">
                            <Border Width="40" Height="22" CornerRadius="4" BorderBrush="#CCC" BorderThickness="1"
                                    Background="{Binding PageBackground}" ToolTip.Tip="{Binding Name}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding MaleSeat}"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding FemaleSeat}"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding BoardBackground}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,4" VerticalAlignment="Center"/>

                <!-- 글꼴 -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,4">
                    <TextBlock Text="글꼴" VerticalAlignment="Center" Foreground="#5A6270"/>
                    <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                              MinWidth="160" MaxDropDownHeight="360"
                              ToolTip.Tip="좌석표(미리보기·인쇄물)에 쓸 글꼴입니다. 한글이 없는 글꼴을 골라도 한글은 자동으로 대체 글꼴로 나옵니다.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:ChartFontOption">
                                <TextBlock Text="{Binding Display}" FontFamily="{Binding Preview}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,4" VerticalAlignment="Center"/>

                <!-- 커스텀 이미지 -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,4">
                    <Button Content="배경" Command="{Binding LoadBackgroundCommand}"/>
                    <Button Content="✕" Command="{Binding ClearBackgroundCommand}" IsEnabled="{Binding HasBackground}" Padding="7,4"/>
                    <Border Width="6"/>
                    <CheckBox Content="남녀 색 구분" IsChecked="{Binding GenderColors}" VerticalAlignment="Center"
                              ToolTip.Tip="켜면 좌석을 남/여 색으로 구분하고 남자리·여자리 셀 이미지를 쓸 수 있습니다. 끄면 모든 칸이 한 가지 배경으로 통일됩니다."/>
                    <Border Width="6" IsVisible="{Binding GenderColors}"/>
                    <Button Content="남자리 셀" Command="{Binding LoadMaleCellCommand}" IsVisible="{Binding GenderColors}"/>
                    <Button Content="✕" Command="{Binding ClearMaleCellCommand}" IsEnabled="{Binding HasMaleCell}"
                            IsVisible="{Binding GenderColors}" Padding="7,4"/>
                    <Border Width="6" IsVisible="{Binding GenderColors}"/>
                    <Button Content="여자리 셀" Command="{Binding LoadFemaleCellCommand}" IsVisible="{Binding GenderColors}"/>
                    <Button Content="✕" Command="{Binding ClearFemaleCellCommand}" IsEnabled="{Binding HasFemaleCell}"
                            IsVisible="{Binding GenderColors}" Padding="7,4"/>
                    <Border Width="6" IsVisible="{Binding GenderColors}"/>
                    <CheckBox Content="셀 투명 배경" IsChecked="{Binding TransparentCells}" VerticalAlignment="Center"
                              IsVisible="{Binding GenderColors}" IsEnabled="{Binding HasAnyCellImage}"
                              ToolTip.Tip="'남자리 셀'·'여자리 셀' 이미지를 넣었을 때만 쓰는 옵션입니다. 켜면 카드 배경·테두리·모서리 자르기 없이 이미지 모양 그대로 나오고, 불투명 이미지는 모서리 단색 배경을 자동으로 지웁니다."/>
                </StackPanel>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,4" VerticalAlignment="Center"/>

                <!-- 출력 -->
                <CheckBox Content="칠판 표시" IsChecked="{Binding ShowBoard}" VerticalAlignment="Center" Margin="0,4,10,4"/>
                <CheckBox Content="교탁 기준" IsChecked="{Binding FlipForTeacher}" VerticalAlignment="Center" Margin="0,4,10,4"
                          ToolTip.Tip="좌석을 거울반전하고 칠판을 아래로(교탁에서 본 방향)"/>
                <Button Content="인쇄" Command="{Binding PrintCommand}"
                        Padding="18,7" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,4"
                        ToolTip.Tip="윈도우 인쇄 대화상자를 엽니다. 프린터·매수를 고르면 A4 한 장에 맞춰 인쇄합니다(용지가 세로면 자동으로 눕혀서)."/>

            </WrapPanel>
        </Border>

        <!-- 미리보기 — 인쇄될 A4 가로 한 장 그대로(같은 여백·같은 맞춤 방식) -->
        <Border Grid.Row="1" Background="#EDEEF0" CornerRadius="8" BorderBrush="#DDD"
                BorderThickness="1" ClipToBounds="True" Padding="16">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- 종이 한 장(A4 가로). 크기 단위는 pt지만 비율만 쓰이므로 화면에서는 통째로 확대·축소된다. -->
                <Border Width="{Binding PageWidth}" Height="{Binding PageHeight}"
                        Background="White" BorderBrush="#C8CBD0" BorderThickness="1"
                        BoxShadow="0 2 10 0 #33000000">
                    <!-- 여백 안쪽에 좌석표를 비율 그대로 꽉 채운다 = 인쇄 때와 같은 계산 -->
                    <Viewbox Stretch="Uniform" Margin="{Binding PageMargin}">
                        <ContentControl Content="{Binding PreviewChart}"/>
                    </Viewbox>
                </Border>
            </Viewbox>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="Gray" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </Grid>

</UserControl>
