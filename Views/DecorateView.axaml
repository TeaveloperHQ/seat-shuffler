<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SeatShuffler.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600"
             x:Class="SeatShuffler.Views.DecorateView"
             x:DataType="vm:DecorateViewModel">

    <Design.DataContext>
        <vm:DecorateViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto" Margin="12">
        <!-- 스킨 + 옵션 + 출력 -->
        <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="8" Padding="10" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">

                <!-- 불러오기 -->
                <TextBlock Text="불러오기" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          Width="240" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:ChartSource"><TextBlock Text="{Binding Label}"/></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,0" VerticalAlignment="Center"/>

                <!-- 스킨 (라벨 생략) — 작게, 폭 모자라면 가로 슬라이드 -->
                <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin}"
                         Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                         MaxWidth="300"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ChartSkin">
                            <Border Width="40" Height="22" CornerRadius="4" BorderBrush="#CCC" BorderThickness="1"
                                    Background="{Binding PageBackground}" ToolTip.Tip="{Binding Name}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding MaleSeat}"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding FemaleSeat}"/>
                                    <Border Width="8" Height="8" CornerRadius="2" Background="{Binding BoardBackground}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,0" VerticalAlignment="Center"/>

                <!-- 커스텀 이미지 -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Content="배경" Command="{Binding LoadBackgroundCommand}"/>
                    <Button Content="✕" Command="{Binding ClearBackgroundCommand}" IsEnabled="{Binding HasBackground}" Padding="7,4"/>
                    <Border Width="6"/>
                    <Button Content="남자리 셀" Command="{Binding LoadMaleCellCommand}"/>
                    <Button Content="✕" Command="{Binding ClearMaleCellCommand}" IsEnabled="{Binding HasMaleCell}" Padding="7,4"/>
                    <Border Width="6"/>
                    <Button Content="여자리 셀" Command="{Binding LoadFemaleCellCommand}"/>
                    <Button Content="✕" Command="{Binding ClearFemaleCellCommand}" IsEnabled="{Binding HasFemaleCell}" Padding="7,4"/>
                    <Border Width="6"/>
                    <CheckBox Content="셀 투명 배경" IsChecked="{Binding TransparentCells}" VerticalAlignment="Center"
                              ToolTip.Tip="특이한 모양/투명 PNG 셀일 때 카드 배경·테두리 없이 이미지 그대로. 불투명 이미지는 단색 배경 자동 제거."/>
                </StackPanel>

                <Border Width="1" Height="28" Background="#D5D5D5" Margin="12,0" VerticalAlignment="Center"/>

                <!-- 출력 -->
                <CheckBox Content="칠판 표시" IsChecked="{Binding ShowBoard}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox Content="교탁 기준" IsChecked="{Binding FlipForTeacher}" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip.Tip="좌석을 거울반전하고 칠판을 아래로(교탁에서 본 방향)"/>
                <Button Content="출력(PNG)" Command="{Binding ExportCommand}"
                        Padding="18,7" FontWeight="SemiBold" VerticalAlignment="Center"/>

            </WrapPanel>
        </Border>

        <!-- 미리보기 -->
        <Border Grid.Row="1" Background="{Binding PreviewBackground}" CornerRadius="8" BorderBrush="#DDD"
                BorderThickness="1" ClipToBounds="True">
            <Grid>
            <Image Source="{Binding PreviewBackgroundImage}" Stretch="UniformToFill"
                   IsVisible="{Binding HasBackground}"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <Border Background="#2E3B2E" CornerRadius="4" Padding="6" Margin="0,0,0,10"
                            HorizontalAlignment="Center" Width="240" IsVisible="{Binding BoardAtTop}">
                        <TextBlock Text="칠판 (앞)" Foreground="#CFE8CF" HorizontalAlignment="Center" FontSize="12"/>
                    </Border>
                    <ItemsControl ItemsSource="{Binding PreviewSections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SeatSectionViewModel">
                                <StackPanel Margin="10,0">
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                               Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:SeatRowViewModel">
                                                <ItemsControl ItemsSource="{Binding Seats}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:SeatSlotViewModel">
                                                            <Border Background="{Binding Background}"
                                                                    BorderBrush="{Binding Border}" BorderThickness="{Binding BorderThickness}"
                                                                    CornerRadius="8" Margin="{Binding Margin}" Width="92" Height="58"
                                                                    ClipToBounds="{Binding CellClip}">
                                                                <Grid>
                                                                    <Image Source="{Binding CellImage}" Stretch="{Binding CellStretch}"
                                                                           IsVisible="{Binding HasCellImage}"/>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                                                   Foreground="{Binding Foreground}" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding SubText}" FontSize="10"
                                                                                   Foreground="{Binding Foreground}" HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#2E3B2E" CornerRadius="4" Padding="6" Margin="0,10,0,0"
                            HorizontalAlignment="Center" Width="240" IsVisible="{Binding BoardAtBottom}">
                        <TextBlock Text="칠판 (앞)" Foreground="#CFE8CF" HorizontalAlignment="Center" FontSize="12"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="Gray" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </Grid>

</UserControl>
