<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SeatShuffler.ViewModels"
             xmlns:models="using:SeatShuffler.Models"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600"
             x:Class="SeatShuffler.Views.ConstraintsView"
             x:DataType="vm:ConstraintsViewModel">

    <Design.DataContext>
        <vm:ConstraintsViewModel/>
    </Design.DataContext>

    <UserControl.Resources>
        <DataTemplate x:Key="StudentItem" DataType="models:Student">
            <TextBlock Text="{Binding Name}"/>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- PIN 칸의 비밀번호 보기 버튼이 Tab 포커스를 가로채지 않도록 제외 -->
        <Style Selector="TextBox.pin /template/ :is(Button)">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- 잠금 화면 -->
        <Border IsVisible="{Binding IsLocked}" Background="#FAFAFA">
            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="12"
                    Padding="28" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0 2 12 0 #1A000000">
                <StackPanel Spacing="12" KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="🔒 제약 탭 잠김" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="민감한 정보가 있어 보호됩니다. 학생에게 노출되지 않도록 주의하세요."
                               Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center"/>

                    <!-- 최초 설정 -->
                    <StackPanel IsVisible="{Binding ShowSetup}" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Text="처음 사용 — PIN을 설정하세요 (4자리 이상)" FontSize="12" Foreground="#555"/>
                        <TextBox Text="{Binding PinInput}" Classes="pin" PasswordChar="●" Watermark="새 PIN"
                                 UseFloatingWatermark="False" TabIndex="1"/>
                        <TextBox Text="{Binding PinConfirm}" Classes="pin" PasswordChar="●" Watermark="PIN 확인" TabIndex="2">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SetPinCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="PIN 설정하고 열기" Command="{Binding SetPinCommand}" TabIndex="3"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,10" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 잠금 해제 -->
                    <StackPanel IsVisible="{Binding ShowUnlock}" Spacing="8" Margin="0,6,0,0">
                        <TextBox Text="{Binding PinInput}" Classes="pin" PasswordChar="●" Watermark="PIN 입력" TabIndex="1">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding UnlockCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="열기" Command="{Binding UnlockCommand}" TabIndex="2"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,10" FontWeight="SemiBold"/>
                        <Button Content="PIN을 잊으셨나요?" Command="{Binding ForgotPinCommand}" TabIndex="3"
                                HorizontalAlignment="Center" Background="Transparent"
                                Foreground="#3498DB" Padding="2" FontSize="12"/>
                    </StackPanel>

                    <!-- PIN 분실 → 초기화 확인 -->
                    <StackPanel IsVisible="{Binding ShowReset}" Spacing="10" Margin="0,6,0,0">
                        <TextBlock Text="제약을 모두 삭제하고 새 PIN을 설정합니다. 기존 짝 금지·짝 필수·앞자리 설정이 사라집니다."
                                   Foreground="#C0392B" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Content="제약 초기화하고 새 PIN 설정" Command="{Binding ResetConstraintsCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Padding="0,10" FontWeight="SemiBold"/>
                        <Button Content="취소" Command="{Binding CancelResetCommand}"
                                HorizontalAlignment="Center" Background="Transparent"
                                Foreground="#888" Padding="2" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LockMessage}" Foreground="#C0392B" FontSize="12"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 제약 내용 (잠금 해제 시에만) -->
        <ScrollViewer IsVisible="{Binding IsUnlocked}">
            <StackPanel Margin="14" Spacing="14">

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="제약 조건" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="각 카드에서 제약을 설정합니다. 카드 오른쪽 손잡이(≡)를 잡고 끌어 우선순위를 바꾸세요 — 위일수록 끝까지 지키고, 아래일수록 충돌 시 먼저 양보합니다. (동성/이성짝·회피 등 배정 옵션은 '배정' 탭에서 켜며, 항상 제약보다 먼저 양보됩니다.)"
                                   Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="PIN 변경" Command="{Binding ChangePinCommand}"
                            VerticalAlignment="Top"/>
                </Grid>

                <!-- 통합 제약 카드 (드래그로 우선순위) -->
                <ItemsControl x:Name="PriorityList" ItemsSource="{Binding Cards}" DragDrop.AllowDrop="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ConstraintCardViewModel">
                            <Border Background="#F4F5F7" CornerRadius="8" Padding="14" Margin="0,4">
                                <StackPanel Spacing="8">
                                    <!-- 헤더: 제목 + 드래그 손잡이 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#888" FontSize="12"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Tag="draghandle" Background="Transparent"
                                                Cursor="Hand" Padding="10,0" VerticalAlignment="Stretch"
                                                ToolTip.Tip="끌어서 우선순위 변경">
                                            <TextBlock Text="≡" FontSize="22" Foreground="#999"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <!-- 짝 금지 -->
                                    <StackPanel IsVisible="{Binding IsForbidden}" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox ItemsSource="{Binding Owner.Students}" SelectedItem="{Binding Owner.ForbiddenA}"
                                                      ItemTemplate="{StaticResource StudentItem}" Width="170" PlaceholderText="학생 A"/>
                                            <TextBlock Text="✕" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <ComboBox ItemsSource="{Binding Owner.Students}" SelectedItem="{Binding Owner.ForbiddenB}"
                                                      ItemTemplate="{StaticResource StudentItem}" Width="170" PlaceholderText="학생 B"/>
                                            <Button Content="추가" Command="{Binding Owner.AddForbiddenCommand}"/>
                                            <Button Content="선택 삭제" Command="{Binding Owner.RemoveForbiddenCommand}"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Owner.ForbiddenRows}" SelectedItem="{Binding Owner.SelectedForbidden}"
                                                 MaxHeight="120" Background="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:PairRow"><TextBlock Text="{Binding Display}"/></DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- 짝 필수 -->
                                    <StackPanel IsVisible="{Binding IsRequired}" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox ItemsSource="{Binding Owner.Students}" SelectedItem="{Binding Owner.RequiredA}"
                                                      ItemTemplate="{StaticResource StudentItem}" Width="170" PlaceholderText="학생 A"/>
                                            <TextBlock Text="♥" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <ComboBox ItemsSource="{Binding Owner.Students}" SelectedItem="{Binding Owner.RequiredB}"
                                                      ItemTemplate="{StaticResource StudentItem}" Width="170" PlaceholderText="학생 B"/>
                                            <Button Content="추가" Command="{Binding Owner.AddRequiredCommand}"/>
                                            <Button Content="선택 삭제" Command="{Binding Owner.RemoveRequiredCommand}"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Owner.RequiredRows}" SelectedItem="{Binding Owner.SelectedRequired}"
                                                 MaxHeight="120" Background="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:PairRow"><TextBlock Text="{Binding Display}"/></DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- 앞자리 -->
                                    <StackPanel IsVisible="{Binding IsFront}" Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="앞쪽" VerticalAlignment="Center"/>
                                            <NumericUpDown Value="{Binding Owner.FrontRowCount}" Minimum="1" Maximum="12"
                                                           Increment="1" FormatString="0" Width="100"/>
                                            <TextBlock Text="행까지" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <ComboBox ItemsSource="{Binding Owner.Students}" SelectedItem="{Binding Owner.FrontStudent}"
                                                      ItemTemplate="{StaticResource StudentItem}" Width="170" PlaceholderText="학생"/>
                                            <Button Content="추가" Command="{Binding Owner.AddFrontCommand}"/>
                                            <Button Content="선택 삭제" Command="{Binding Owner.RemoveFrontCommand}"/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding Owner.FrontRows}" SelectedItem="{Binding Owner.SelectedFront}"
                                                 MaxHeight="120" Background="White">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="vm:FrontRow"><TextBlock Text="{Binding Display}"/></DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- 남녀 자리 (설정은 좌석 설정 탭) -->
                                    <StackPanel IsVisible="{Binding IsGenderSeat}">
                                        <TextBlock Text="'좌석 설정' 탭에서 좌석을 남자리/여자리로 칠해 지정합니다. 여기서는 우선순위만 정합니다."
                                                   Foreground="#666" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
