<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SeatShuffler.ViewModels"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="600"
             x:Class="SeatShuffler.Views.SeatSetupView"
             x:DataType="vm:SeatSetupViewModel">

    <Design.DataContext>
        <vm:SeatSetupViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">
        <!-- 그리드 크기 + 칠하기 모드 -->
        <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="8" Padding="12" Margin="0,0,0,8">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4" VerticalAlignment="Center">
                    <TextBlock Text="분단" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding Sections}" Minimum="1" Maximum="8" Increment="1"
                                   FormatString="0" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,16,4" VerticalAlignment="Center">
                    <TextBlock Text="행" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding Rows}" Minimum="1" Maximum="12" Increment="1"
                                   FormatString="0" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,24,4" VerticalAlignment="Center">
                    <TextBlock Text="열" VerticalAlignment="Center"/>
                    <NumericUpDown Value="{Binding Cols}" Minimum="1" Maximum="8" Increment="1"
                                   FormatString="0" Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="칠하기:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <RadioButton Content="빈자리" GroupName="paint" IsChecked="{Binding ModeEmpty}"/>
                    <RadioButton Content="남자리" GroupName="paint" IsChecked="{Binding ModeMale}"/>
                    <RadioButton Content="여자리" GroupName="paint" IsChecked="{Binding ModeFemale}"/>
                    <RadioButton Content="자유(지우기)" GroupName="paint" IsChecked="{Binding ModeFree}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 칠판 -->
        <Border Grid.Row="1" Background="#2E3B2E" CornerRadius="4" Padding="6" Margin="0,0,0,10"
                HorizontalAlignment="Center" Width="240">
            <TextBlock Text="칠판 (앞)" Foreground="#CFE8CF" HorizontalAlignment="Center" FontSize="12"/>
        </Border>

        <!-- 좌석 그리드 -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding SectionsView}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SeatSectionViewModel">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="{Binding Title}" HorizontalAlignment="Center"
                                       Foreground="#888" FontSize="12" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:SeatRowViewModel">
                                        <ItemsControl ItemsSource="{Binding Seats}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SeatSlotViewModel">
                                                    <Button Command="{Binding ToggleCommand}"
                                                            CommandParameter="{Binding Position}"
                                                            Background="{Binding Background}"
                                                            BorderBrush="{Binding Border}" BorderThickness="1"
                                                            CornerRadius="8" Margin="{Binding Margin}"
                                                            Width="92" Height="56" Padding="0" Cursor="Hand">
                                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{Binding Foreground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="Gray"
                   FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"/>
    </Grid>

</UserControl>
