<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SeatShuffler.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="SeatShuffler.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1000" Height="640" MinWidth="760" MinHeight="500"
        Title="자리바꾸기">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="8">
        <TabItem Header="학생 명단">
            <ContentControl Content="{Binding Roster}"/>
        </TabItem>
        <TabItem Header="제약">
            <ContentControl Content="{Binding Constraints}"/>
        </TabItem>
        <TabItem Header="배정">
            <ContentControl Content="{Binding Assignment}"/>
        </TabItem>
        <TabItem Header="기록">
            <ContentControl Content="{Binding History}"/>
        </TabItem>
        <TabItem Header="정보">
            <ContentControl Content="{Binding Info}"/>
        </TabItem>
    </TabControl>

</Window>
